# Environment Variable Reference for Agro Linken Backend
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your actual values.
# NEVER commit the actual .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase / PostgreSQL Database ───────────────────────────────────────────
# Full JDBC URL to your Supabase PostgreSQL instance
# Direct Connection: jdbc:postgresql://db.<project_ref>.supabase.co:5432/postgres?sslmode=require
# Transaction Pooler: jdbc:postgresql://aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# Render example: jdbc:postgresql://your-supabase-host:5432/postgres?sslmode=require
DB_URL=jdbc:postgresql://db.YOUR_SUPABASE_REF.supabase.co:5432/postgres?sslmode=require

# PostgreSQL / Supabase credentials
DB_USERNAME=postgres
DB_PASSWORD=your_supabase_db_password

# ── Firebase Admin SDK ────────────────────────────────────────────────────────
# Option A (Production / Render deployment):
#   Set FIREBASE_CREDENTIALS to the full JSON content of your service account key.
#   The backend reads this env var first when present.
FIREBASE_CREDENTIALS={"type":"service_account","project_id":"your-project-id","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# Option B (Local development only):
#   Place your Firebase service account key JSON file at the project root,
#   name it serviceAccountKey.json, and set the path below in application.properties.
#   The file is listed in .gitignore and must NEVER be committed.
#   firebase.service-account-path=serviceAccountKey.json
