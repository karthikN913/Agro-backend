# =============================================================================
# Agro Linken — .gitignore
# =============================================================================

# ── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
firebase-debug.log*
firebase-debug.*.log*

# ── Environment & Secrets ─────────────────────────────────────────────────────
.env
.env.*
!.env.example
serviceAccountKey.json
*serviceAccount*.json
*service-account*.json
firebase-adminsdk*.json

# ── Firebase Cache ────────────────────────────────────────────────────────────
.firebase/

# ── Node.js ───────────────────────────────────────────────────────────────────
node_modules/
.npm
.eslintcache
.node_repl_history
*.tgz
.yarn-integrity
.nyc_output
coverage/
lib-cov/
.grunt
bower_components/
.lock-wscript
build/Release
.dataconnect

# ── Maven & Java Build Outputs ────────────────────────────────────────────────
target/
*.class
*.jar
*.war
*.ear

# ── Local Maven Installation (developer tooling — not part of the project) ───
apache-maven-3.9.6/
apache-maven.zip

# ── Runtime Data ─────────────────────────────────────────────────────────────
pids/
*.pid
*.seed
*.pid.lock

# ── IDE & Editor Files ────────────────────────────────────────────────────────
# Eclipse / Spring Tool Suite
.classpath
.project
.settings/
.factorypath

# VS Code
.vscode/
*.code-workspace

# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# ── Miscellaneous ─────────────────────────────────────────────────────────────
*.bak
*.tmp
*.swp
*~
